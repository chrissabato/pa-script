APP_ENV=development
APP_DEBUG=true
APP_TIMEZONE=America/Los_Angeles

# Your school. Unset = Willamette's values (the original install).
# SITE_NAME shows in the page header (quote values with spaces); HOME_TEAM_SLUG is your school's slug in
# the Team Data API (preselected as the home team); TEAMS_API_URL is where
# schools, mascots and logos sync from — Willamette's API is public and lists
# its opponents, or host your own with the same JSON (see README).
#SITE_NAME="Willamette Athletics"
#HOME_TEAM_SLUG=willamette-university
#TEAMS_API_URL=https://athletics.willamette.edu/api/teams
# URL prefix the app is served under (production: /pa). Leave unset to detect
# it from the front controller's location; set it empty for a domain root.
#APP_BASE_PATH=/pa

# Production: read DB_HOST/DB_PORT/DB_NAME/DB_USER/DB_PASS from the server's
# shared credentials JSON instead of the DB_* lines below, and keep this app's
# tables in their own schema of that shared database.
#DB_CREDS_FILE=/www/athletics.willamette.edu/creds.pgsql.json
#DB_SCHEMA=pa_script

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=pa_script
DB_USER=pa_script
DB_PASS=pa_script_dev

# The one password everyone logs in with (no usernames). Leave unset to turn
# the login off, e.g. for local dev. Changing it logs everyone out.
#APP_PASSWORD=

# A second password for script templates, snippets and default venues, so
# standard users can't change every game's script. Unset = those pages are
# open to everyone who can use the app.
#ADMIN_PASSWORD=

# Shared secret embedded in the generated bookmarklet URL.
IMPORT_TOKEN=change-me

# Gemini API key for "Fill in from a document" on roster pages (Google AI
# Studio). Leave unset to hide the feature. The default model is
# gemini-3.5-flash-lite with minimal thinking (~3 s); a bigger model such as
# gemini-3.8-flash took 1-3 minutes for the same results.
#GEMINI_API_KEY=
#GEMINI_MODEL=gemini-3.5-flash-lite
#GEMINI_THINKING_LEVEL=minimal
