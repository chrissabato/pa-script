APP_ENV=development
APP_DEBUG=true
APP_TIMEZONE=America/Los_Angeles
# URL prefix the app is served under (production: /pa). Leave unset to detect
# it from the front controller's location; set it empty for a domain root.
#APP_BASE_PATH=/pa

# Production: read DB_HOST/DB_PORT/DB_NAME/DB_USER/DB_PASS from the server's
# shared credentials JSON instead of the DB_* lines below, and keep this app's
# tables in their own schema of that shared database.
#DB_CREDS_FILE=/www/athletics.willamette.edu/creds.pgsql.json
#DB_SCHEMA=pa_script

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=pa_script
DB_USER=pa_script
DB_PASS=pa_script_dev

# The one password everyone logs in with (no usernames). Leave unset to turn
# the login off, e.g. for local dev. Changing it logs everyone out.
#APP_PASSWORD=

# Shared secret embedded in the generated bookmarklet URL.
IMPORT_TOKEN=change-me
