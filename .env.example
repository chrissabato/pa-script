APP_ENV=development
APP_DEBUG=true
APP_TIMEZONE=America/Los_Angeles

# Your school. SITE_NAME shows in the page header before "PA Script" (quote
# values with spaces). HOME_TEAM_SLUG is your school's slug in the team API,
# preselected as the home team (unset = none).
#SITE_NAME="Example Athletics"
#HOME_TEAM_SLUG=example-university

# Required: the Team Data API that schools, mascots and logos sync from. No
# default — teams don't sync without it. Run your own with
# https://github.com/chrissabato/opponent-api
TEAMS_API_URL=

# URL prefix the app is served under (e.g. /pa). Leave unset to detect
# it from the front controller's location; set it empty for a domain root.
#APP_BASE_PATH=/pa

# Optional: read DB_HOST/DB_PORT/DB_NAME/DB_USER/DB_PASS from a credentials
# JSON file instead of the DB_* lines below, and/or keep this app's tables in
# their own schema of a shared database.
#DB_CREDS_FILE=/path/to/creds.json
#DB_SCHEMA=pa_script

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=pa_script
DB_USER=pa_script
DB_PASS=pa_script_dev

# The one password everyone logs in with (no usernames). Leave unset to turn
# the login off, e.g. for local dev. Changing it logs everyone out.
#APP_PASSWORD=

# A second password for script templates, snippets and default venues, so
# standard users can't change every game's script. Unset = those pages are
# open to everyone who can use the app.
#ADMIN_PASSWORD=

# Shared secret embedded in the generated bookmarklet URL.
IMPORT_TOKEN=change-me

# Gemini API key for "Fill in from a document" on roster pages (Google AI
# Studio). Leave unset to hide the feature. The default model is
# gemini-3.5-flash-lite with minimal thinking (~3 s); a bigger model such as
# gemini-3.8-flash took 1-3 minutes for the same results.
#GEMINI_API_KEY=
#GEMINI_MODEL=gemini-3.5-flash-lite
#GEMINI_THINKING_LEVEL=minimal
