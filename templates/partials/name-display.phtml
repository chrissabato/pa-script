<?php
/**
 * Name display selector for the Script and Teleprompter pages. Expects
 * $game and $nameDisplayReturnTo ('script' or 'teleprompter'); saves on
 * change (and works as a plain form without JS).
 */
?>
<form method="post" action="<?= $this->base() ?>/games/<?= (int) $game['id'] ?>/name-display" class="name-display">
    <input type="hidden" name="return_to" value="<?= htmlspecialchars($nameDisplayReturnTo, ENT_QUOTES) ?>">
    <label>Names
        <select name="name_display" onchange="this.form.submit()">
            <?php foreach (\App\Rendering\Spoken::NAME_DISPLAYS as $value => $label): ?>
                <option value="<?= $value ?>" <?= ($game['name_display'] ?? \App\Rendering\Spoken::DEFAULT_NAME_DISPLAY) === $value ? 'selected' : '' ?>><?= $label ?></option>
            <?php endforeach; ?>
        </select>
    </label>
    <noscript><button type="submit">Apply</button></noscript>
</form>
