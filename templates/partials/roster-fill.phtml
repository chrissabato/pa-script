<?php
/**
 * "Fill in from a document" panel on a game's roster page: upload game
 * notes or a pronunciation guide and Gemini suggests the blank fields and
 * flags where the document disagrees with the roster.
 *
 * Expects: $game, $side, $fillEnabled.
 */
?>
<section class="roster-import roster-fill">
    <h3>Fill in from a document</h3>
    <?php if (!$fillEnabled): ?>
        <p class="hint">Not set up yet: add <code>GEMINI_API_KEY</code> to the server's <code>.env</code>.</p>
    <?php else: ?>
    <form method="post" enctype="multipart/form-data" class="roster-import-url roster-fill-form"
          action="<?= $this->base() ?>/games/<?= (int) $game['id'] ?>/roster/<?= htmlspecialchars($side, ENT_QUOTES) ?>/fill">
        <label>Game notes or pronunciation guide
            <input type="file" name="document" accept=".pdf,.docx,.txt,application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document" required>
        </label>
        <button type="submit">Check the roster</button>
    </form>
    <p class="hint">
        Drop a PDF or Word (.docx) file here, or choose one, and Gemini looks for what's blank below — pronunciations, coaches' seasons,
        positions, years, hometowns — and for anything the document says differently (numbers, spellings, years, ...). You review
        every suggestion before anything is saved; differences are only changed if you tick them.
    </p>
    <script>
        (function () {
            var panel = document.querySelector('.roster-fill');
            var form = panel.querySelector('.roster-fill-form');
            var input = form.querySelector('input[type=file]');
            var button = form.querySelector('button');
            var submitting = false;

            function submit() {
                if (submitting) {
                    return;
                }
                submitting = true;
                button.disabled = true;
                button.textContent = 'Reading the document…';
                form.submit();
            }

            form.addEventListener('submit', function (e) {
                e.preventDefault();
                if (input.files.length) {
                    submit();
                }
            });

            // Drop a file anywhere on the panel: it goes into the file input
            // and uploads straight away.
            var depth = 0;
            panel.addEventListener('dragenter', function (e) {
                e.preventDefault();
                depth++;
                panel.classList.add('is-dragover');
            });
            panel.addEventListener('dragover', function (e) {
                e.preventDefault();
                e.dataTransfer.dropEffect = 'copy';
            });
            panel.addEventListener('dragleave', function () {
                if (--depth === 0) {
                    panel.classList.remove('is-dragover');
                }
            });
            panel.addEventListener('drop', function (e) {
                e.preventDefault();
                depth = 0;
                panel.classList.remove('is-dragover');
                if (e.dataTransfer.files.length) {
                    input.files = e.dataTransfer.files;
                    submit();
                }
            });
        })();
    </script>
    <?php endif; ?>
</section>
