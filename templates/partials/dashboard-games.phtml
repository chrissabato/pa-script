<?php
/**
 * Dashboard games table. Expects $dashboardGames and $showDate (false for
 * the Today section, where every row has the same date).
 */
?>
<table>
    <tr><th></th><?php if ($showDate): ?><th>Date</th><?php endif; ?><th>Time</th><th>Sport</th><th>Away</th><th>Home</th><th>Status</th></tr>
    <?php foreach ($dashboardGames as $game): ?>
    <tr>
        <td><a href="<?= $this->base() ?>/games/<?= (int) $game['id'] ?>" class="button button-secondary">Open</a></td>
        <?php if ($showDate): ?>
        <td class="nowrap"><?= htmlspecialchars(date('l, M j', strtotime($game['date'])), ENT_QUOTES) ?></td>
        <?php endif; ?>
        <td class="nowrap"><?= $game['time_of_day'] ? htmlspecialchars(date('g:i A', strtotime($game['time_of_day'])), ENT_QUOTES) : '' ?></td>
        <td>
            <?= htmlspecialchars($game['sport_name'], ENT_QUOTES) ?>
            <?php if ($game['division_name']): ?>(<?= htmlspecialchars($game['division_name'], ENT_QUOTES) ?>)<?php endif; ?>
        </td>
        <?php foreach (['away', 'home'] as $side): ?>
        <td>
            <?php require __DIR__ . '/team-cell.phtml'; ?>
            <?= $side === 'home' && $game['is_neutral_site'] ? '<span class="neutral-note">(neutral site)</span>' : '' ?>
        </td>
        <?php endforeach; ?>
        <td><span class="badge badge-<?= htmlspecialchars($game['status'], ENT_QUOTES) ?>"><?= htmlspecialchars($game['status'], ENT_QUOTES) ?></span></td>
    </tr>
    <?php endforeach; ?>
</table>
