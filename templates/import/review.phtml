<form method="post" action="/import/review/<?= (int) $batch['id'] ?>/discard" onsubmit="return confirm('Discard this batch? This cannot be undone.')">
    <button type="submit" class="button-danger">Discard batch</button>
</form>

<template id="import-row-template">
    <tr>
        <td><input type="checkbox" name="players[__INDEX__][include]" value="1" checked></td>
        <td><input type="text" name="players[__INDEX__][number]" size="3"></td>
        <td><input type="text" name="players[__INDEX__][name]"></td>
        <td><input type="text" name="players[__INDEX__][pronunciation]"></td>
        <td><input type="text" name="players[__INDEX__][position]"></td>
        <td><input type="text" name="players[__INDEX__][year]" size="4"></td>
        <td><input type="text" name="players[__INDEX__][hometown]"></td>
        <td><input type="checkbox" name="players[__INDEX__][is_starter]" value="1"></td>
    </tr>
</template>

<script>
(function () {
    var nextIndex = <?= count($players) ?>;
    var table = document.getElementById('import-rows-table');
    var template = document.getElementById('import-row-template');

    document.getElementById('add-row-button').addEventListener('click', function () {
        var html = template.innerHTML.split('__INDEX__').join(String(nextIndex));
        var tempTable = document.createElement('table');
        tempTable.innerHTML = html;
        table.appendChild(tempTable.querySelector('tr'));
        nextIndex += 1;
    });
})();
</script>
