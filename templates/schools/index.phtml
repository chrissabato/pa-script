<?php
use App\Teams\TeamApiSync;

$providers = ['sidearm' => 'Sidearm', 'presto' => 'Presto', 'presto_old' => 'Presto (old)'];

// Rows not refreshed by the latest sync are teams the API no longer lists
// but a game/roster still uses (the sync keeps those rather than break them).
$isStale = function (array $school) use ($lastSyncedAt): bool {
    return $lastSyncedAt !== null && $school['synced_at'] !== $lastSyncedAt;
};
?>
<h2>Teams</h2>
<p><em>
    Teams come from the athletics
    <a href="<?= TeamApiSync::BASE_URL ?>/docs">Team Data API</a> and are edited in its
    <a href="<?= TeamApiSync::BASE_URL ?>/admin">admin</a>, not here. This app keeps a local copy,
    refreshed automatically at most hourly so scripts still work if the API is down.
</em></p>

<form method="post" action="/schools/sync" class="sync-bar">
    <button type="submit" class="button-secondary">Sync now</button>
    <span>
        <?php if ($lastSyncedAt !== null): ?>
            Last synced <?= htmlspecialchars(date('l, M j g:i A', (int) strtotime($lastSyncedAt . ' UTC')), ENT_QUOTES) ?>
        <?php else: ?>
            Never synced
        <?php endif; ?>
    </span>
</form>

<?php if ($syncError !== null): ?>
    <p class="notice notice-error">Couldn't refresh from the team API: <?= htmlspecialchars((string) $syncError, ENT_QUOTES) ?> Showing the last synced copy.</p>
<?php elseif ($syncResult !== null): ?>
    <p class="notice">Synced: <?= (int) $syncResult['updated'] ?> updated, <?= (int) $syncResult['inserted'] ?> added, <?= (int) $syncResult['removed'] ?> removed.</p>
<?php endif; ?>

<table class="teams-table">
    <tr>
        <th>Logo</th><th>Full name</th><th>Short name</th><th>Mascot</th><th>Color</th><th>URL</th><th>CMS provider</th>
    </tr>
    <?php foreach ($schools as $school): ?>
    <tr>
        <td>
            <span class="logo-thumb" style="background: <?= htmlspecialchars((string) ($school['logo_bg'] ?? $school['color'] ?? 'transparent'), ENT_QUOTES) ?>">
                <?php if ($school['logo']): ?><img src="<?= htmlspecialchars($school['logo'], ENT_QUOTES) ?>" alt="" loading="lazy"><?php endif; ?>
            </span>
        </td>
        <td>
            <?= htmlspecialchars($school['name'], ENT_QUOTES) ?>
            <?php if ($isStale($school)): ?><span class="badge badge-draft" title="No longer in the team API; kept because a game or roster uses it.">not in API</span><?php endif; ?>
        </td>
        <td><?= htmlspecialchars((string) $school['short_name'], ENT_QUOTES) ?></td>
        <td><?= htmlspecialchars((string) $school['mascot'], ENT_QUOTES) ?></td>
        <td class="nowrap"><?= htmlspecialchars((string) $school['color'], ENT_QUOTES) ?></td>
        <td><?php if ($school['url']): ?><a href="<?= htmlspecialchars($school['url'], ENT_QUOTES) ?>" target="_blank" rel="noopener"><?= htmlspecialchars(preg_replace('#^https?://#', '', $school['url']), ENT_QUOTES) ?></a><?php endif; ?></td>
        <td><?= htmlspecialchars($providers[$school['cms_provider']] ?? (string) $school['cms_provider'], ENT_QUOTES) ?></td>
    </tr>
    <?php endforeach; ?>
</table>
