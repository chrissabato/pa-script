<h2>New Game</h2>
<?php if ($syncError !== null): ?>
    <p class="notice notice-error">Couldn't refresh teams from the team API (<?= htmlspecialchars($syncError, ENT_QUOTES) ?>); showing the last synced list.</p>
<?php endif; ?>
<form method="post" action="<?= $this->base() ?>/games">
    <p>
        <label>Team:
        <select name="team" required>
            <?php foreach (\App\Repository\SportRepository::TEAMS as $value => $label): ?>
                <option value="<?= htmlspecialchars($value, ENT_QUOTES) ?>"><?= htmlspecialchars($label, ENT_QUOTES) ?></option>
            <?php endforeach; ?>
        </select></label>
    </p>

    <p>
        <label class="inline-check"><input type="checkbox" name="is_conference" value="1" checked> Conference game (Northwest Conference)</label>
    </p>
    <p>
        <label class="inline-check"><input type="checkbox" name="is_neutral_site" value="1"> Neutral site (neither team gets home framing)</label>
    </p>

    <div class="team-pick">
        <fieldset>
            <legend>Away team</legend>
            <p>
            <select name="away_school_id" required>
                <option value="">— choose a team —</option>
                <?php foreach ($schools as $school): ?>
                    <option value="<?= (int) $school['id'] ?>"><?= htmlspecialchars(\App\Repository\SchoolRepository::label($school), ENT_QUOTES) ?></option>
                <?php endforeach; ?>
            </select></p>
        </fieldset>
        <fieldset>
            <legend>Home team</legend>
            <p>
            <select name="home_school_id" required>
                <option value="">— choose a team —</option>
                <?php foreach ($schools as $school): ?>
                    <option value="<?= (int) $school['id'] ?>"<?= $school['slug'] === \App\Site::homeTeamSlug() ? ' selected' : '' ?>><?= htmlspecialchars(\App\Repository\SchoolRepository::label($school), ENT_QUOTES) ?></option>
                <?php endforeach; ?>
            </select></p>
        </fieldset>
    </div>

    <p>
        Date: <input type="date" name="date" required>
        Time: <input type="time" name="time_of_day">
    </p>

    <button type="submit">Create game</button>
</form>
