<?php $gameTab = 'overview'; require __DIR__ . '/../partials/game-nav.phtml'; ?>

<h3>Rosters</h3>
<div class="roster-status">
    <?php foreach (['home', 'away'] as $side): ?>
    <?php
        $count = $rosterCounts[$side];
        $isEmpty = $count['players'] === 0 && $count['coaches'] === 0;
    ?>
    <a class="roster-status-card<?= $isEmpty ? ' is-empty' : '' ?>" href="/games/<?= (int) $game['id'] ?>/roster/<?= $side ?>">
        <span class="roster-status-side"><?= ucfirst($side) ?></span>
        <strong><?= htmlspecialchars((string) $game[$side . '_school_name'], ENT_QUOTES) ?></strong>
        <?php if ($isEmpty): ?>
            <span class="roster-status-counts">Not imported yet — open to fetch the roster</span>
        <?php else: ?>
            <span class="roster-status-counts">
                <?= $count['players'] ?> athlete<?= $count['players'] === 1 ? '' : 's' ?>
                <?php if ($count['starters'] > 0): ?>(<?= $count['starters'] ?> starting)<?php endif; ?>
                &middot; <?= $count['coaches'] ?> coach<?= $count['coaches'] === 1 ? '' : 'es' ?>
            </span>
        <?php endif; ?>
    </a>
    <?php endforeach; ?>
</div>

<h3>Officials</h3>
<form method="post" action="/games/<?= (int) $game['id'] ?>/officials">
    <p>
        Official: <input type="text" name="official" required>
        Role: <input type="text" name="role">
        Sort: <input type="number" name="sort_order" value="0" size="3">
        <button type="submit">Add official</button>
    </p>
</form>
