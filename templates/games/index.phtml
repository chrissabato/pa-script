<h2>Games</h2>
<p><a href="<?= $this->base() ?>/games/new" class="button">+ New game</a></p>
<table>
    <tr><th>Date</th><th>Sport</th><th>Matchup</th><th>Venue</th><th>Status</th><th></th></tr>
    <?php foreach ($games as $game): ?>
    <tr>
        <td><?= htmlspecialchars($game['date'], ENT_QUOTES) ?></td>
        <td><?= htmlspecialchars($game['sport_name'], ENT_QUOTES) ?></td>
        <td>
            <?= htmlspecialchars((string) $game['home_school_name'], ENT_QUOTES) ?>
            vs
            <?= htmlspecialchars((string) $game['away_school_name'], ENT_QUOTES) ?>
            <?= $game['is_neutral_site'] ? '(neutral site)' : '' ?>
        </td>
        <td><?= htmlspecialchars((string) $game['venue'], ENT_QUOTES) ?></td>
        <td><span class="badge badge-<?= htmlspecialchars($game['status'], ENT_QUOTES) ?>"><?= htmlspecialchars($game['status'], ENT_QUOTES) ?></span></td>
        <td class="nowrap">
            <a href="<?= $this->base() ?>/games/<?= (int) $game['id'] ?>" class="button button-secondary">Open</a>
            <form method="post" action="<?= $this->base() ?>/games/<?= (int) $game['id'] ?>" style="display:inline">
                <button type="submit" name="_method" value="DELETE"
                    onclick="return confirm('Delete this game (<?= htmlspecialchars(addslashes($game['date'] . ' ' . $game['home_school_name'] . ' vs ' . $game['away_school_name']), ENT_QUOTES) ?>)? Its rosters and officials are deleted too.')">Delete</button>
            </form>
        </td>
    </tr>
