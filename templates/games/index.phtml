<h2>Games</h2>
<p><a href="<?= $this->base() ?>/games/new" class="button">+ New game</a></p>
<table>
    <tr><th>Date</th><th>Sport</th><th>Away</th><th>Home</th><th>Status</th><th></th></tr>
    <?php foreach ($games as $game): ?>
    <tr>
        <td><?= htmlspecialchars($game['date'], ENT_QUOTES) ?></td>
        <td><?= htmlspecialchars($game['sport_name'], ENT_QUOTES) ?><?php if ($game['division_name']): ?> (<?= htmlspecialchars($game['division_name'], ENT_QUOTES) ?>)<?php endif; ?></td>
        <?php foreach (['away', 'home'] as $side): ?>
        <td>
            <?php require __DIR__ . '/../partials/team-cell.phtml'; ?>
            <?= $side === 'home' && $game['is_neutral_site'] ? '<span class="neutral-note">(neutral site)</span>' : '' ?>
        </td>
        <?php endforeach; ?>
        <td><span class="badge badge-<?= htmlspecialchars($game['status'], ENT_QUOTES) ?>"><?= htmlspecialchars($game['status'], ENT_QUOTES) ?></span></td>
        <td class="nowrap">
            <a href="<?= $this->base() ?>/games/<?= (int) $game['id'] ?>" class="button button-secondary">Open</a>
            <form method="post" action="<?= $this->base() ?>/games/<?= (int) $game['id'] ?>" style="display:inline">
                <button type="submit" name="_method" value="DELETE"
                    onclick="return confirm('Delete this game (<?= htmlspecialchars(addslashes($game['date'] . ' ' . $game['away_school_name'] . ' vs ' . $game['home_school_name']), ENT_QUOTES) ?>)? Its rosters and officials are deleted too.')">Delete</button>
            </form>
        </td>
    </tr>
    <?php endforeach; ?>
</table>
