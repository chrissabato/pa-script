<?php
/**
 * Review of a document check's suggestions (App\Fill\RosterFiller): the
 * blank fields Gemini found a value for (ticked by default) and the fields
 * where the document disagrees with the roster (unticked — the announcer
 * decides which is right). Values are editable; only ticked rows are saved.
 *
 * Expects: $game, $side, $filename, $suggestions (null on error), $error.
 */
$rosterUrl = $this->base() . '/games/' . (int) $game['id'] . '/roster/' . htmlspecialchars($side, ENT_QUOTES);
$fieldLabels = [
    'number' => 'Number', 'name' => 'Name', 'pronunciation' => 'Pronunciation', 'position' => 'Position',
    'year' => 'Year', 'hometown' => 'Hometown', 'pronoun' => 'Pronoun', 'seasons' => 'Seasons',
];
$rows = $suggestions === null ? [] : array_merge($suggestions['coaches'], $suggestions['players']);
$missing = array_values(array_filter($rows, function (array $row): bool {
    return $row['current'] === null;
}));
$differences = array_values(array_filter($rows, function (array $row): bool {
    return $row['current'] !== null;
}));
$hasEvidence = array_filter(array_column($rows, 'evidence')) !== [];

$table = function (array $rows, bool $checked, bool $showCurrent) use ($fieldLabels, $hasEvidence): void {
    ?>
    <div class="table-scroll">
    <table class="roster-table fill-review">
        <tr>
            <th class="cell-center">Save</th><th>Person</th><th>Field</th>
            <?php if ($showCurrent): ?><th>On the roster</th><?php endif; ?>
            <th><?= $showCurrent ? 'In the document' : 'Value' ?></th>
            <?php if ($hasEvidence): ?><th>From the document</th><?php endif; ?>
        </tr>
        <?php foreach ($rows as $row): ?>
            <?php $key = htmlspecialchars($row['kind'] . ':' . (int) $row['id'] . ':' . $row['field'], ENT_QUOTES); ?>
            <tr>
                <td class="cell-center">
                    <input type="checkbox" name="apply[]" value="<?= $key ?>"<?= $checked ? ' checked' : '' ?>>
                    <input type="hidden" name="current[<?= $key ?>]" value="<?= htmlspecialchars((string) $row['current'], ENT_QUOTES) ?>">
                </td>
                <td><?= htmlspecialchars($row['label'], ENT_QUOTES) ?><?= $row['kind'] === 'coach' ? ' <em>(coach)</em>' : '' ?></td>
                <td><?= $fieldLabels[$row['field']] ?></td>
                <?php if ($showCurrent): ?><td><?= htmlspecialchars((string) $row['current'], ENT_QUOTES) ?></td><?php endif; ?>
                <td><input type="text" name="value[<?= $key ?>]" value="<?= htmlspecialchars((string) $row['value'], ENT_QUOTES) ?>"></td>
                <?php if ($hasEvidence): ?><td class="hint"><?= htmlspecialchars($row['evidence'], ENT_QUOTES) ?></td><?php endif; ?>
            </tr>
        <?php endforeach; ?>
    </table>
    </div>
    <?php
};
?>
<?php $gameTab = $side; require __DIR__ . '/../partials/game-nav.phtml'; ?>

<h3>Check against <?= $filename !== '' ? htmlspecialchars($filename, ENT_QUOTES) : 'a document' ?></h3>

<?php if ($error !== null): ?>
    <p class="notice notice-error"><?= htmlspecialchars($error, ENT_QUOTES) ?></p>
    <p><a href="<?= $rosterUrl ?>">&larr; Back to the roster</a></p>
<?php elseif ($rows === []): ?>
    <p class="notice">The document had nothing new for this roster, and nothing on the roster disagrees with it.</p>
    <p><a href="<?= $rosterUrl ?>">&larr; Back to the roster</a></p>
<?php else: ?>
    <form method="post" action="<?= $rosterUrl ?>/fill/apply">
        <?php if ($differences !== []): ?>
            <h4>Differences from the document (<?= count($differences) ?>)</h4>
            <p class="hint">
                The roster and the document disagree on these. Nothing changes unless you tick it — tick the ones where the
                document is right (correct the value if needed).
            </p>
            <?php $table($differences, false, true); ?>
        <?php endif; ?>
        <?php if ($missing !== []): ?>
            <h4>Missing details (<?= count($missing) ?>)</h4>
            <p class="hint">
                Gemini found these for fields that are blank on the roster. Check each against the document — untick anything wrong,
                or correct the value.
            </p>
            <?php $table($missing, true, false); ?>
        <?php endif; ?>
        <p>
            <button type="submit">Save ticked</button>
            <a href="<?= $rosterUrl ?>" class="button button-secondary">Cancel</a>
        </p>
    </form>
<?php endif; ?>
