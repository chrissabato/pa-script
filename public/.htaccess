# Apache front controller: real files (css/js) are served directly,
# everything else goes to Slim. Works at a domain root or in a subfolder
# (athletics.willamette.edu/pa) — the app detects its base path.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [QSA,L]
</IfModule>

# Willamette's install: off campus, require a Willamette SSO (Shibboleth)
# login; on campus (158.104.0.0/16, the university's public address block)
# stays open. Another school: delete this section (without Shibboleth
# installed, Apache errors on it) or change the address block.
#
# Exempt: the bookmarklet's two endpoints. They're called cross-site from
# another school's roster page, which carries no Shibboleth session, and
# each already checks the shared IMPORT_TOKEN.
#
# Matched on THE_REQUEST (the original request line) rather than
# REQUEST_URI because the rewrite to index.php re-runs access checks with
# REQUEST_URI = .../index.php. The path pattern doesn't name /pa, so it
# keeps working if the app moves.
<If "! -R '158.104.0.0/16' && %{THE_REQUEST} !~ m#^[A-Z]+ /(?:[^ ?]*/)?(?:bookmarklet/scraper\.js|api/import/stage)[? ]#">
    AuthType shibboleth
    AuthName "PA Script"
    ShibRequestSetting requireSession 1
    Require shib-session
</If>
