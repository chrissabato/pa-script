{
    "name": "willamette/pa-script",
    "description": "PA announcer script generator for Willamette University Athletics",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^7.2",
        "ext-pdo": "*",
        "ext-pdo_pgsql": "*",
        "robmorgan/phinx": "^0.13.4",
        "slim/psr7": "^1.4",
        "slim/slim": "^4.8",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "7.2.34"
        },
        "sort-packages": true
    },
    "require-dev": {
        "phpunit/phpunit": "^8.5"
    }
}
